#!/usr/bin/env node

import path from "node:path";
import fsp from "node:fs/promises";

const ROOT_DIR = path.join(import.meta.dirname,"..");
const SRC_DIR = path.join(ROOT_DIR,"src");
const WEB_DIR = path.join(ROOT_DIR,"web");
const WEB_JS_DIR = path.join(WEB_DIR,"js");

// Copied src/ -> web/js/. Every import among these is sibling-
// relative, so they stay resolvable as a flat set with no
// specifier rewriting. Anything else in web/js/ is authored.
const COPY_FILES = [
	"parser-combinators.js",
	"tokenizer.js",
	"fast-tokenizer.js",
	"parser.js",
	"default-shapers.js",
	"highlighter.js",
	"source-context.js",
];


main().catch(err => {
	console.error(err);
	process.exitCode = 1;
});


// **********************

async function main() {
	console.log("*** Building Foi-Toy Web ***");

	var [
		packageJSON,
		copyrightHeader,
		tmplHTMLCode,
		tmplCSSCode,
	] = await Promise.all([
		fsp.readFile(path.join(ROOT_DIR,"..","package.json"),"utf-8"),
		fsp.readFile(path.join(SRC_DIR,"copyright-header.txt"),"utf-8"),
		fsp.readFile(path.join(SRC_DIR,"tmpl.html"),"utf-8"),
		fsp.readFile(path.join(SRC_DIR,"tmpl.css"),"utf-8"),
	]);

	packageJSON = JSON.parse(packageJSON);

	// read version number from package.json
	var version = packageJSON.version;
	var year = (new Date()).getFullYear();

	// process copyright header
	copyrightHeader = copyrightHeader
		.replace(/`/g,"")
		.replace(/#VERSION#/g,version)
		.replace(/#YEAR#/g,year);

	var syntaxColorHTML = tmplHTMLCode.replace("<style></style>",`<style>\n${tmplCSSCode}</style>`);

	await fsp.mkdir(WEB_JS_DIR,{ recursive: true, });

	await Promise.all([
		fsp.writeFile(path.join(WEB_DIR,"syntax-color.html"),syntaxColorHTML,"utf-8"),

		...COPY_FILES.map(async filename => {
			let code = await fsp.readFile(path.join(SRC_DIR,filename),"utf-8");
			let header = copyrightHeader.replace("#FILENAME#",filename);
			await fsp.writeFile(path.join(WEB_JS_DIR,filename),`${header}${code}`,"utf-8");
		}),
	]);

	console.log(`Copied ${COPY_FILES.length} files to web/js/.`);
	console.log("Complete.");
}
