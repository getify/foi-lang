// ============================================================
// IO (deferred computation with implicit Reader environment
//     + Promise transformer + Using transformer)
//   Slot holds < :id, :executor >, plus an optional
//   :usingRelease field on instances from IO.using@.
//   Executor signature: (env) -> value.
//   Reader is read-only within a chain; env changes start a
//   new IO context via IO.mapEnv@ / IO.withEnv@ / IO.updateEnv@.
// ============================================================

deft IOT({(Any) ^Any})
	:Effects(Host.Slot.Write, Host.Counter)
	^IO;
defn{IOT} IO@(executor) {
	def inst: <>;
	def id: Effect.Host.Counter%;
	Effect.Host.Slot.Write% <inst, <:id, :executor>>;
	^inst
};

deft IOofT(Any) ^IO;
defn{IOofT} IO.of@(v)
	^IO@ (defn(env) ^v);

// -- `%`: run executor; unary passes empty env, binary passes
//    supplied env. Returns whatever the executor produced —
//    either a bare value or a Promise (transformer lift). --

deft IOEffectorT(IO, ?Any)
	:Effects(Host.Slot.Read)
	^Any;
defn{IOEffectorT} IO%(inst, env :? empty) {
	def state: Effect.Host.Slot.Read% inst;

	// composition never routes an IO here — `~<`, `~map`, and the
	// sub-context helpers invoke the executor directly — so a
	// using-IO arriving here was run without a bind, and its
	// release is lost
	?[state ?has "usingRelease"]:
		Effect.Sys.Warn% "IO.using@ leak: no bind to release";

	// sole drive point for the chain (§6.14.4); the executor may
	// hand back a ContinuationTrampoline rather than a value
	^contRamp(state.executor(env))
};


// -- Bind: sequence two IO computations, passing env through
//    unchanged. Promise-lift when previous step produces a
//    Promise; env captured in the ~< cb closure. --

deft IOBindT(IO, {(Any) ^IO})
	:Effects(Host.Slot.Read)
	^IO;
defn{IOBindT} IO~<(inst, fn) {
	def ioSlot: Effect.Host.Slot.Read% inst;

	^IO@ (defn(env) {
		^ContinuationTrampoline@ <
			(defn() ^ioSlot.executor(env)),
			(defn(res) {
				^?{
					[res ?as Promise]: res ~< (resV) {
						processIOStep(resV,env) #> contRamp #> liftPromise;
					};
					: processIOStep(res,env)
				}
			})
		>
	});


	// ****************************************

	defn liftPromise(v) ^?(v){
		[?as Promise]: v;
		: Promise.honor@ v
	};

	deft ProcessIOStepT(Any,Any)
		:Effects(Host.Slot.Read)
		^Any;
	defn{ProcessIOStepT} processIOStep(res,env) {
		def next: fn(res);
		def nextState: Effect.Host.Slot.Read% next;
		def step: (defn() ^nextState.executor(env));

		// the release must not fire until the downstream work has
		// actually run — post-conversion `step()` can hand back a
		// trampoline, so the release rides as the resume, which the
		// bounce invokes only once a real value has emerged
		^?{
			[ioSlot ?has "usingRelease"]:
				ContinuationTrampoline@ < step, releaseAfter >;
			: ContinuationTrampoline@ < step >
		};


		// ****************************************

		defn releaseAfter(res2) ^?{
			[res2 ?as Promise]: (~cata)(
				res2,
				defn(res2Err) {
					ioSlot.usingRelease(res)% env;
					^Promise.renege@ res2Err
				},
				defn(res2V) {
					ioSlot.usingRelease(res)% env;
					^Promise.honor@ res2V
				}
			);
			: {
				ioSlot.usingRelease(res)% env;
				res2
			}
		};
	};
};


// -- Map: transform the produced value; env passes through
//    unchanged. Same Promise-lift as ~<. --
deft IOMapT(IO, {(Any) ^Any})
	:Effects(Host.Slot.Read)
	^IO;
defn{IOMapT} IO~map(inst, fn) {
	def state: Effect.Host.Slot.Read% inst;

	// mapping a using-IO discards its release: `~map` never
	// consults one, and the mapped value isn't the resource
	?{
		[state ?has "usingRelease"]:
			Effect.Sys.Warn% "IO.using@ leak: no bind to release";
	};

	^IO@ (defn(env) {
		^ContinuationTrampoline@ <
			(defn() ^state.executor(env)),
			(defn(prev) {
				^?{
					[prev ?as Promise]: prev ~map fn;
					: fn(prev)
				}
			})
		>
	})
};

// -- Reference identity via minted id --

deft IOEqT(IO, IO)
	:Effects(Host.Slot.Read)
	^bool;
defn{IOEqT} IO?=(a, b) ^(
	(Effect.Host.Slot.Read% a).id ?= (Effect.Host.Slot.Read% b).id
);

// ============================================================
// Named IO constructors — Reader environment access
// ============================================================

// -- Read env as observed value --

deft IOAskT() ^IO;
defn{IOAskT} IO.ask@()
	^IO@ (defn(env) ^env);

// -- Project env via fn --

deft IOAsksT({(Any) ^Any}) ^IO;
defn{IOAsksT} IO.asks@(fn)
	^IO@ (defn(env) ^fn(env));


deft UsingReleaseT(Any) ^IO;
deft Using < acquire: IO, release: UsingReleaseT >;
deft IOUsingFactoryT(Using)
	:Effects(Host.Slot)
	^IO;
defn{IOUsingFactoryT} IO.using@(< :acquire, :release >) {
	def io: IO@ (defn(env) ^(acquire% env));
	def ioSlot: Effect.Host.Slot.Read% io;
	Effect.Host.Slot.Write% < io, < &ioSlot, usingRelease: release > >;
	^io
};


// ============================================================
// Sub-context helpers — env change starts a new IO context.
//
// Each helper is curried: (env-configurator) -> (sub-IO) -> IO.
// The returned sub-IO transformer, when applied to a sub-IO,
// yields an outer IO that runs the sub-IO under a derived env.
// The outer chain's env is unaffected.
//
// IO.mapEnv@ is the primitive; withEnv@ and updateEnv@ compose
// atop it.
// ============================================================

// -- Type of the returned sub-IO transformer: (IO) -> IO. --
deft SubIOT(IO)
	:Effects(Host.Slot)
	^IO;

// -- mapEnv: derive newEnv via arbitrary fn, run sub-IO under it.
//    A using sub-IO's release is carried onto the outer IO, wrapped
//    in the same derivation, so acquire and release both observe
//    fn(env). Invokes the sub's executor directly rather than via
//    `%` — machinery must not trip the unbound-using diagnosis. --
deft IOMapEnvT({(Any) ^Any}) ^SubIOT;
defn{IOMapEnvT} IO.mapEnv@(fn)
	^(defn{SubIOT}(subIO) {
		def subSlot: Effect.Host.Slot.Read% subIO;
		def outer: IO@ (defn(env) ^(subSlot.executor(fn(env))));

		?{
			[subSlot ?has "usingRelease"]: {
				def outerSlot: Effect.Host.Slot.Read% outer;
				Effect.Host.Slot.Write% <
					outer,
					< &outerSlot, usingRelease: hoistedRelease >
				>;
			};
		};

		^outer;


		// ****************************************

		defn hoistedRelease(res) ^IO@ (defn(env)
			^(subSlot.usingRelease(res)% fn(env)));
	});

// -- withEnv: replace env wholesale, run sub-IO under newEnv. --

deft IOWithEnvT(Any) ^SubIOT;
defn{IOWithEnvT} IO.withEnv@(newEnv)
	^IO.mapEnv@ (Function@ newEnv);

// -- updateEnv: merge patch into current env, run sub-IO under it. --

deft IOUpdateEnvT(Any) ^SubIOT;
defn{IOUpdateEnvT} IO.updateEnv@(patchEnv)
	^IO.mapEnv@ (defn(env) ^< &env, &patchEnv >);



