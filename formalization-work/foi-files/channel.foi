deft ChannelPutT(Any)
	:Effects(Host.Slot)
	^Promise;
deft ChannelTakeT()
	:Effects(Host.Slot)
	^Promise;
deft ChannelPeekT()
	:Effects(Host.Slot)
	^Promise;
deft ChannelCloseT()
	:Effects(Host.Slot)
	^Either;

deft ChannelT(?int)
	:Effects(Host.Slot.Write, Host.Counter)
	^Channel;
defn{ChannelT} Channel@(cap :? 0)
	![cap ?as int ?and cap ?>= 0]: Left@ "Invalid buffer capacity"
{
	def id: Effect.Host.Counter%;
	def inst: <
		put: putFn,
		take: takeFn,
		peek: peekFn,
		close: closeFn
	>;

	Effect.Host.Slot.Write% < inst, <
		:id,
		closed: false,
		capacity: cap,
		buffer: <>,
		putQueue: <>,
		takeQueue: <>,
		peekWaiters: <>
	>>;

	^inst;

	// ***********************

	defn{ChannelPutT} putFn(v) {
		def state: Effect.Host.Slot.Read% inst;

		^?{
			[state.closed]:
				Promise.renege@ "Channel Closed";

			[size(state.takeQueue) ?> 0]: {
				def takeSubj: state.takeQueue.0;
				def restTakes: state.takeQueue.[1..];
				Effect.Host.Slot.Write% < inst, < &state, takeQueue: restTakes >>;
				takeSubj% (Right@ v);
				drainPeeks(v);
				Promise.honor@ true
			};

			[size(state.buffer) ?< state.capacity]: {
				Effect.Host.Slot.Write% < inst, < &state, buffer: < &state.buffer, v >>>;
				drainPeeks(v);
				Promise.honor@ true
			};

			: {
				def subj: Promise.subj@;
				Effect.Host.Slot.Write% < inst, < &state, putQueue: < &state.putQueue, < :subj, value: v >>>>;
				drainPeeks(v);
				subj.pr
			}
		};
	};

	defn{ChannelTakeT} takeFn() {
		def state: Effect.Host.Slot.Read% inst;

		^?{
			[size(state.buffer) ?> 0]: {
				def headV: state.buffer.0;
				def restBuf: state.buffer.[1..];
				?{
					[size(state.putQueue) ?> 0]: {
						def putEntry: state.putQueue.0;
						Effect.Host.Slot.Write% < inst, < &state,
							buffer: < &restBuf, putEntry.value >,
							putQueue: state.putQueue.[1..]
						>>;
						putEntry.subj% (Right@ true);
					};
					: Effect.Host.Slot.Write% < inst, < &state, buffer: restBuf >>;
				};
				Promise.honor@ headV;
			};

			[size(state.putQueue) ?> 0]: {
				def putEntry: state.putQueue.0;
				def restPuts: state.putQueue.[1..];
				Effect.Host.Slot.Write% < inst, < &state, putQueue: restPuts >>;
				putEntry.subj% (Right@ true);
				Promise.honor@ putEntry.value;
			};

			[state.closed]:
				Promise.renege@ "Channel Closed";

			: {
				def subj: Promise.subj@;
				Effect.Host.Slot.Write% < inst, < &state, takeQueue: < &state.takeQueue, subj >>>;
				subj.pr;
			}
		};
	};

	defn{ChannelPeekT} peekFn() {
		def state: Effect.Host.Slot.Read% inst;

		^?{
			[size(state.buffer) ?> 0]:
				Promise.honor@ state.buffer.0;

			[size(state.putQueue) ?> 0]:
				Promise.honor@ state.putQueue.0.value;

			[state.closed]:
				Promise.renege@ "Channel Closed";

			: {
				def subj: Promise.subj@;
				Effect.Host.Slot.Write% < inst, < &state, peekWaiters: < &state.peekWaiters, subj >>>;
				subj.pr;
			}
		};
	};

	defn{ChannelCloseT} closeFn() {
		def state: Effect.Host.Slot.Read% inst;

		^?{
			[state.closed]:
				Left@ "Channel Closed";

			: {
				Effect.Host.Slot.Write% < inst, < &state, closed: true, putQueue: <>, takeQueue: <>, peekWaiters: <>> >;

				state.putQueue ~each (entry) {
					entry.subj% (Left@ "Channel Closed");
				};

				state.takeQueue ~each (subj) {
					subj% (Left@ "Channel Closed");
				};

				?[size(state.buffer) ?= 0]: {
					state.peekWaiters ~each (subj) {
						subj% (Left@ "Channel Closed");
					};
				};

				Right@ true;
			}
		};
	};

	// internal helper
	deft drainPeeksT(Any)
		:Effects(Host.Slot)
		^empty;
	defn{drainPeeksT} drainPeeks(v) {
		def state: Effect.Host.Slot.Read% inst;
		def waiters: state.peekWaiters;
		Effect.Host.Slot.Write% < inst, < &state, peekWaiters: <>> >;
		waiters ~each (subj) {
			subj% (Right@ v);
		};
	};
};

deft ChannelEqT(Channel, Channel)
	:Effects(Effect.Host.Slot.Read) ^bool;
defn{ChannelEqT} Channel?=(a, b) ^(
	(Effect.Host.Slot.Read% a).id ?= (Effect.Host.Slot.Read% b).id
);

deft ChannelDoT({(Any)^Any}, Any) ^Promise;
defn{ChannelDoT} Channel~<*(comp, ty) {
	^Effect.Host.Do ~<* (eff:: comp, ret) {
		?(eff){
			[?as Effect.Host.Do.Bind]: {
				def ch: #.value;
				def loopResult: Promise.subj@;

				defn stepIteration() ^ContinuationTrampoline@ < takeOnce >;

				defn takeOnce() {
					def inline: true;
					def next: empty;
					(~cata)(ch.take(), closeArm, valueArm);
					inline := false;
					^next;

					// ***********************

					defn valueArm(v) :over (next) {
						Effect.Host.Do ~<* (eff2:: ret(v), ret2) {
							?(eff2){
								[?as Effect.Host.Do.Bind]: Done@ empty;
								[?as Effect.Host.Do.Map]: Done@ #.value;
							}
						};
						^?{
							[inline]: next := stepIteration();
							: contRamp(stepIteration())
						};
					};

					defn closeArm(reason) ^loopResult% (Left@ reason);
				};

				contRamp(stepIteration());
				Done@ loopResult.pr;
			};

			[?as Effect.Host.Do.Map]: {
				// Terminal reached with no v:: ch bind at all —
				// no channel iteration ever happened.
				Done@ (Promise.honor@ #.value);
			};
		};
	};
};


// -- Module-internal: positional replace. Rebuilds rather than
//    mutating, so arrival order never reaches the result — the
//    index fixes the slot. O(N) per arrival by construction.

deft SetAtT(List, int, Any) ^List;
defn{SetAtT} setAt(xs, i, v) ^(
	(List.entries@ xs) ~map (< idx, cur >) {
		?{
			[idx ?= i]: v;
			: cur
		}
	}
);


// -- PUBLIC: coordination combinators (§6.9.5).
//
//    The derived channel is capacity-1, not unbuffered. takeFn
//    checks the buffer before [state.closed], and closeFn clears
//    the queues but leaves the buffer — so a value put into a
//    capacity-1 derived survives the auto-close and the caller's
//    later take() still receives it. Unbuffered would park the put
//    in putQueue, which close reneges.
//
//    alts@ observes with peek(), not take(). take() on every source
//    would leave consuming takes queued on the losers with no way
//    to cancel them. peek() doesn't consume, resolves in-line when
//    a value is already queued (giving left-to-right arbitration),
//    and a stale peek resolving after the race is decided is
//    discarded by the `won` guard. Only the winner is taken from.

deft ChannelAltsT(List)
	:Effects(Host.Slot)
	^Channel;
defn{ChannelAltsT} Channel.alts@(chs) {
	def derived: Channel@ 1;
	def coord: <>;
	Effect.Host.Slot.Write% <coord, < won: false, closedCount: 0 >>;

	?{
		[size(chs) ?= 0]: derived.close();
		: chs ~each (src) {
			(~cata)(
				src.peek(),
				(defn(reason) ^noteClosed()),
				(defn(v) ^tryWin(src))
			);
		}
	};

	^derived;

	// ***********************

	deft TryWinT(Channel)
		:Effects(Host.Slot)
		^Any;
	defn{TryWinT} tryWin(src) {
		def c: Effect.Host.Slot.Read% coord;
		^?{
			[c.won]: empty;
			: {
				Effect.Host.Slot.Write% <coord, < &c, won: true >>;
				(~cata)(
					src.take(),
					(defn(reason) ^empty),
					(defn(v) {
						derived.put(< value: v, channel: src >);
						derived.close();
					})
				)
			}
		};
	};

	deft NoteClosedT()
		:Effects(Host.Slot)
		^Any;
	defn{NoteClosedT} noteClosed() {
		def c: Effect.Host.Slot.Read% coord;
		def next: < &c, closedCount: c.closedCount + 1 >;
		Effect.Host.Slot.Write% <coord, next>;
		^?{
			[!next.won ?and next.closedCount ?= size(chs)]: derived.close();
			: empty
		};
	};
};

deft ChannelEveryT(List)
	:Effects(Host.Slot)
	^Channel;
defn{ChannelEveryT} Channel.every@(chs) {
	def derived: Channel@ 1;
	def coord: <>;
	Effect.Host.Slot.Write% <coord,
		settled: 0,
		done: false,
		results: (chs ~map (c) { empty })
	>>;

	?{
		[size(chs) ?= 0]: derived.close();
		: (List.entries@ chs) ~each (< idx, src >) {
			(~cata)(
				src.take(),
				(defn(reason) ^bail()),
				(defn(v) ^arrive(idx, v))
			);
		}
	};

	^derived;

	// ***********************

	deft EveryArriveT(int, Any)
		:Effects(Host.Slot)
		^Any;
	defn{EveryArriveT} arrive(idx, v) {
		def c: Effect.Host.Slot.Read% coord;
		^?{
			[c.done]: empty;
			: {
				def next: < &c,
					settled: c.settled + 1,
					results: setAt(c.results, idx, v)
				>;
				Effect.Host.Slot.Write% <coord, next>;
				?{
					[next.settled ?= size(chs)]: {
						Effect.Host.Slot.Write% <coord, < &next, done: true >>;
						derived.put(next.results);
						derived.close();
					};
					: empty
				}
			}
		};
	};

	deft BailT()
		:Effects(Host.Slot)
		^Any;
	defn{BailT} bail() {
		def c: Effect.Host.Slot.Read% coord;
		^?{
			[c.done]: empty;
			: {
				Effect.Host.Slot.Write% <coord, < &c, done: true >>;
				derived.close()
			}
		};
	};
};




