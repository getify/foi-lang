// 		~< (v) {
// 			?(v){
// 				[?> 50]: Promise.renege@ `"Ooops: `v`";
// 				: Promise.honor@ v;
// 			}
// 		},
// 	defn(reason) { log(reason) },
// 	defn(v) { log(`"v: `v`") }
// );
// // v: 42



