deft ContThunk() ^any;
deft ContResume(any) ^any;
deft ContPair < ContThunk, ContResume >;
deft ContConstruct(ContPair) :Effects(Effect.Host.Slot.Write) ^ContinuationTrampoline;
deft ContBounce(ContinuationTrampoline) :Effects(Effect.Host.Slot.Read) ^any;

defn{ContConstruct} ContinuationTrampoline@(pair) {
	def inst: <>;
	Effect.Host.Slot.Write% < inst, pair >;
	^inst
};

defn{ContBounce} ContinuationTrampoline%(inst) {
	def stack: empty;
	def current: inst;

	?[true] ~each {
		?{
			[current ?as ContinuationTrampoline]: {
				def <left, right:? empty>: Effect.Host.Slot.Read% current;
				?[!empty right]: stack := < right, stack >;
				current := left();
				empty
			};
			[!empty stack]: {
				def <resume, rest>: stack;
				stack := rest;
				current := resume(current);
				empty
			};
			: Done@
		};
	};

	^current
};

// -- Drive helper: bounce if trampolined, pass through otherwise.
//    The discrimination is not an optimization. Values arriving
//    at a drive point may be other namespaces' instances (an IO
//    executor may produce an IO); an unconditional `%` here would
//    apply the wrong hook and, for IO, defeat the §6.12.6 leak
//    diagnosis. Only trampolines bounce.

deft ContRampT(Any) ^Any;
defn{ContRampT} contRamp(v) ^?{
	[v ?as ContinuationTrampoline]: v%;
	: v
};




