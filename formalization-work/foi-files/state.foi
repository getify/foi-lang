// ============================================================
// State (deferred state-threading computation)
//   Slot holds < :id, :changer >.
//
//   Chain depth: a bind/map chain of length N nests N native
//   `state.changer(s)` calls at %-time. Composition steps reify
//   as ContinuationTrampoline pairs; `State%` drives the bounce
//   via contRamp. Public API and the < value, newState > shape
//   are unchanged.
// ============================================================

deft StateT({(Any) ^<Any, Any>})
	:Effects(Host.Slot.Write, Host.Counter)
	^State;
defn{StateT} State@(changer) {
	def inst: <>;
	def id: Effect.Host.Counter%;
	Effect.Host.Slot.Write% <inst, <:id, :changer>>;
	^inst
};

// -- Binary `%`: apply initial state, run the computation --
//    This is the outermost boundary by construction: stdlib
//    machinery below invokes `.changer` directly, never via `%`.

deft StateEffectorT(State, Any)
	:Effects(Host.Slot.Read)
	^<Any, Any>;
defn{StateEffectorT} State%(inst, initState) {
	def state: Effect.Host.Slot.Read% inst;
	^contRamp(state.changer(initState));
};

// -- Bind: sequence two State computations, threading state through --

deft StateBindT(State, {(Any) ^State})
	:Effects(Host.Slot.Read)
	^State;
defn{StateBindT} State~<(inst, fn) {
	def state: Effect.Host.Slot.Read% inst;
	deft BindRCont(< Any, Any >)
		:Effects(Host.Slot.Read)
		^Any;
	^State@ defn(s) {
		^ContinuationTrampoline@ <
			(defn() ^state.changer(s)),
			(defn{BindRCont}(pair) {
				def <v, s2>: pair;
				def nextState: Effect.Host.Slot.Read% fn(v);
				^nextState.changer(s2);
			})
		>;
	};
};

// -- Map: transform the observed value; state passes through unchanged --

deft StateMapT(State, {(Any) ^Any})
	:Effects(Host.Slot.Read)
	^State;
defn{StateMapT} State~map(inst, fn) {
	def state: Effect.Host.Slot.Read% inst;
	^State@ defn(s) {
		^ContinuationTrampoline@ <
			(defn() ^state.changer(s)),
			(defn(pair) {
				def <v, s2>: pair;
				^<fn(v), s2>;
			})
		>;
	};
};

// -- Reference identity via minted id --

deft StateEqT(State, State)
	:Effects(Host.Slot.Read)
	^bool;
defn{StateEqT} State?=(a, b) ^(
	(Effect.Host.Slot.Read% a).id ?= (Effect.Host.Slot.Read% b).id
);

// ============================================================
// Named State constructors (§6.7.3)
//   Base changers return plain tuples — nothing to reify.
// ============================================================

deft StateGetT() ^State;
defn{StateGetT} State.get@()
	^State@ defn(s) ^<s, s>;

deft StateGetsT({(Any) ^Any}) ^State;
defn{StateGetsT} State.gets@(fn)
	^State@ defn(s) ^<fn(s), s>;

deft StateOfT(Any) ^State;
defn{StateOfT} State.of@(v)
	^State@ defn(s) ^<v, s>;

deft StatePutT(Any) ^State;
defn{StatePutT} State.put@(newState)
	^State@ defn(s) ^<empty, newState>;

deft StateModifyT({(Any) ^Any}) ^State;
defn{StateModifyT} State.modify@(fn)
	^State@ defn(s) ^<empty, fn(s)>;





