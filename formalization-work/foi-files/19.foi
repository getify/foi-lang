def x: <1,2,3>;
def y: <4,5,6>;
console.log(<0, &x, &y, 7, 8, 9>);
console.log(<0, &x.1, 7, 8, 9>);
console.log(<0, &x.[1..3], &y.[2..], 7, 8, 9>);

def w: < one: "ok", two: "yes", three: "no" >;
console.log(< zero: "umm", &w, four: "whatever" >);
console.log(< zero: "umm", &w.one, four: "whatever" >);
console.log(< zero: "umm", &w.<one,two>, four: "whatever" >);
